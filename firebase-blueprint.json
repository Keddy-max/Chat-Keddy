{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier for the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the user's profile picture."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "The user's role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the user was created."
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Session": {
      "title": "Session",
      "description": "A chat session containing messages.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the session."
        },
        "messages": {
          "type": "string",
          "description": "JSON stringified array of messages."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update time."
        }
      },
      "required": ["updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "The collection of users."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/Session"
      },
      "description": "The collection of chat sessions for a user."
    }
  }
}
